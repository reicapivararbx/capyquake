    boto: {
      name: 'Boto-Rosa', speed: 3, chaseSpeed: 7, points: 4, health: 60,
      attackDamage: 10, attackRange: 2.5, detectionRange: 16,
      createMesh() {
        const g = new THREE.Group();
        const body = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.5, 2.0), new THREE.MeshLambertMaterial({ color: 0xdd8899 }));
        body.position.y = 0.5; body.castShadow = true; g.add(body);
        const snout = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.15, 0.7), new THREE.MeshLambertMaterial({ color: 0xcc7788 }));
        snout.position.set(0, 0.5, 1.2); g.add(snout);
