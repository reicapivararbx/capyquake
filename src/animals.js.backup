        const legGeo = new THREE.BoxGeometry(0.2, 0.6, 0.2);
        const legMat = new THREE.MeshLambertMaterial({ color: 0xbb8822 });
        [[-0.3,0.3,-0.6],[0.3,0.3,-0.6],[-0.3,0.3,0.5],[0.3,0.3,0.5]].forEach(p => { const l = new THREE.Mesh(legGeo, legMat); l.position.set(...p); g.add(l); });
        const tail = new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.03,1.2,5), new THREE.MeshLambertMaterial({ color: 0xcc9933 }));
        tail.position.set(0,0.9,-1.4); tail.rotation.x = 0.3; g.add(tail);
        return g;
      }
    },

