import * as THREE from 'three';
import { Audio } from './audio.js';

let animalId = 0;

export class Animal {
  constructor(scene, x, z, type, arena) {
    this.scene = scene;
    this.arena = arena;
    this.id = animalId++;
    this.type = type;
    this.alive = true;
    this.config = Animal.TYPES[type];
    this.speed = this.config.speed * (0.8 + Math.random() * 0.4);
    this.chaseSpeed = this.config.chaseSpeed || this.speed * 2;
    this.wanderTimer = 0;
    this.wanderDir = new THREE.Vector3(Math.random() - 0.5, 0, Math.random() - 0.5).normalize();
    this.chasing = false;
    this.points = this.config.points;
    this.health = this.config.health;
    this.attackDamage = this.config.attackDamage;
    this.attackRange = this.config.attackRange || 2.5;
    this.attackCooldown = 0;
    this.detectionRange = this.config.detectionRange || 16;

    this.mesh = this.config.createMesh();
    this.mesh.position.set(x, 0, z);
    scene.add(this.mesh);
  }

  static TYPES = {
    jacare: {
      name: 'Jacaré',
      speed: 1.5,
      chaseSpeed: 5,
      points: 3,
      health: 60,
      attackDamage: 15,
      attackRange: 3,
      detectionRange: 14,
      createMesh() {
        const group = new THREE.Group();
        // Body - long and flat
        const bodyGeo = new THREE.CylinderGeometry(0.8, 0.4, 2.5);
        const bodyMat = new THREE.MeshLambertMaterial({ color: 0x3a4a2a });
        const body = new THREE.Mesh(bodyGeo, bodyMat);
        body.position.y = 0.3;
        body.castShadow = true;
        group.add(body);
        // Head/snout
        const headGeo = new THREE.BoxGeometry(0.5, 0.3, 1.2);
        const headMat = new THREE.MeshLambertMaterial({ color: 0x4a5a3a });
        const head = new THREE.Mesh(headGeo, headMat);
        head.position.set(0, 0.3, 1.7);
        head.castShadow = true;
        group.add(head);
        // Jaw
        const jawGeo = new THREE.BoxGeometry(0.4, 0.1, 1.0);
        const jawMat = new THREE.MeshLambertMaterial({ color: 0x2a3a1a });
        const jaw = new THREE.Mesh(jawGeo, jawMat);
        jaw.position.set(0, 0.15, 1.8);
        group.add(jaw);
        // Eyes
        const eyeGeo = new THREE.SphereGeometry(0.06, 4, 4);
        const eyeMat = new THREE.MeshLambertMaterial({ color: 0xaaaa00 });
        const eyeL = new THREE.Mesh(eyeGeo, eyeMat);
        eyeL.position.set(-0.25, 0.5, 1.4);
        group.add(eyeL);
        const eyeR = eyeL.clone();
        eyeR.position.set(0.25, 0.5, 1.4);
        group.add(eyeR);
        // Tail
        const tailGeo = new THREE.BoxGeometry(0.3, 0.25, 1.5);
        const tailMat = new THREE.MeshLambertMaterial({ color: 0x3a4a2a });
        const tail = new THREE.Mesh(tailGeo, tailMat);
        tail.position.set(0, 0.25, -1.8);
        group.add(tail);
        // Legs
        const legGeo = new THREE.BoxGeometry(0.2, 0.2, 0.2);
        const legMat = new THREE.MeshLambertMaterial({ color: 0x2a3a1a });
        [[-0.35, 0.1, 0.8], [0.35, 0.1, 0.8], [-0.35, 0.1, -0.5], [0.35, 0.1, -0.5]].forEach(([lx, ly, lz]) => {
          const leg = new THREE.Mesh(legGeo, legMat);
          leg.position.set(lx, ly, lz);
          group.add(leg);
        });
        return group;
      }
    },

    tucano: {
      name: 'Tucano',
      speed: 3,
      chaseSpeed: 8,
      points: 5,
      health: 20,
      attackDamage: 8,
      attackRange: 2,
      detectionRange: 20,
      createMesh() {
        const group = new THREE.Group();
        // Body
