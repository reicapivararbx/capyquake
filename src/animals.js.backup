        const trunkMat = new THREE.MeshLambertMaterial({ color: 0x5a4a3a });
        const trunk = new THREE.Mesh(trunkGeo, trunkMat);
        trunk.position.set(0, 1.1, 2.1);
        trunk.rotation.x = Math.PI / 4;
