        const chestMat = new THREE.MeshLambertMaterial({ color: 0xffff44 });
        const chest = new THREE.Mesh(chestGeo, chestMat);
        chest.position.set(0, 3.4, 0.15);
        group.add(chest);
        // Beak (large, orange)
        const beakGeo = new THREE.BoxGeometry(0.15, 0.15, 0.8);
        const beakMat = new THREE.MeshLambertMaterial({ color: 0xff6600 });
        const beak = new THREE.Mesh(beakGeo, beakMat);
        beak.position.set(0, 3.5, 0.6);
        group.add(beak);
        // Beak tip
        const tipGeo = new THREE.BoxGeometry(0.12, 0.12, 0.2);
        const tipMat = new THREE.MeshLambertMaterial({ color: 0xcc0000 });
        const tip = new THREE.Mesh(tipGeo, tipMat);
        tip.position.set(0, 3.5, 1.0);
        group.add(tip);
        // Eyes
        const eyeGeo = new THREE.SphereGeometry(0.05, 4, 4);
        const eyeMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
        const eyeL = new THREE.Mesh(eyeGeo, eyeMat);
        eyeL.position.set(-0.2, 3.6, 0.2);
        group.add(eyeL);
        const eyeR = eyeL.clone();
        eyeR.position.set(0.2, 3.6, 0.2);
        group.add(eyeR);
        // Wings
        const wingGeo = new THREE.BoxGeometry(0.8, 0.05, 0.4);
        const wingMat = new THREE.MeshLambertMaterial({ color: 0x111111 });
        const wingL = new THREE.Mesh(wingGeo, wingMat);
        wingL.position.set(-0.5, 3.5, 0);
        group.add(wingL);
        const wingR = wingL.clone();
        wingR.position.set(0.5, 3.5, 0);
        group.add(wingR);
        // Tail
        const tailGeo = new THREE.BoxGeometry(0.1, 0.05, 0.5);
        const tailMat = new THREE.MeshLambertMaterial({ color: 0xcc0000 });
        const tail = new THREE.Mesh(tailGeo, tailMat);
        tail.position.set(0, 3.4, -0.5);
        group.add(tail);
        return group;
      }
    },

    anta: {
      name: 'Anta',
      speed: 2,
      chaseSpeed: 6,
      points: 2,
      health: 80,
