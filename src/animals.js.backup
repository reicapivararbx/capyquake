        [[-0.45, 0.35, -0.8], [0.45, 0.35, -0.8], [-0.45, 0.35, 0.8], [0.45, 0.35, 0.8]].forEach(([lx, ly, lz]) => {
          const leg = new THREE.Mesh(legGeo, legMat);
          leg.position.set(lx, ly, lz);
